{
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*\\.(?:mp4|webm|png|jpg|jpeg|gif|svg|ico|webp|txt|xml))",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/r/grupogerenci-t742",
      "destination": "https://grupogerencia-cert.lovable.app/",
      "permanent": false
    },
    {
      "source": "/r/:slug*",
      "destination": "https://grupogerencia-cert.lovable.app/",
      "permanent": false
    },
    {
      "source": "/tracker.js",
      "destination": "https://hub.idenza.site/tracker.js",
      "permanent": true
    },
    {
      "source": "/portafolio",
      "destination": "/proyectos",
      "permanent": false
    }
  ]
}
